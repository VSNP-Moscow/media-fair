# Скопируйте в .env и заполните своими значениями.
NODE_ENV=production
PORT=8080

DB_HOST=db
DB_PORT=3306
DB_NAME=media_fair
DB_USER=mf_app
DB_PASSWORD=change-me-strong-password
DB_ROOT_PASSWORD=change-me-root-password

# Не короче 32 символов. Сгенерировать: openssl rand -hex 48
JWT_SECRET=change-me-32-plus-characters-long-secret

# Откуда разрешены запросы браузера (через запятую, без пробелов)
CORS_ORIGINS=https://vsnp-moscow.github.io

# Публикация API только на loopback: наружу отдаёт Caddy
BIND_ADDR=127.0.0.1
BIND_PORT=4010
TRUST_PROXY=true
